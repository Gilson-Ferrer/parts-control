<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parts Control - Restauração</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h1 class="mb-4">Parts Control - Gestão de Restauração</h1>
        
        <!-- Formulário para Cadastro de Peças veiculares -->
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">Adicionar Nova Peça</div>
            <div class="card-body">
                <form action="/adicionar" method="POST">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Nome da Peça</label>
                            <input type="text" name="nome" class="form-control" required placeholder="Ex: Amortecedor Dianteiro">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Part Number (Opcional)</label>
                            <input type="text" name="part_number" class="form-control" placeholder="Código universal">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Preço (R$)</label>
                            <input type="number" step="0.01" name="preco" class="form-control" required placeholder="0.00">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="Pendente">Pendente</option>
                                <option value="Comprada">Comprada</option>
                                <option value="Instalada">Instalada</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Etapa da Restauração</label>
                            <input type="text" name="etapa_nome" class="form-control" required placeholder="Ex: Suspensão">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success mt-3">Salvar Peça</button>
                </form>
            </div>
        </div>

        <!-- Tabela Listando as Peças -->
        <div class="card shadow-sm">
            <div class="card-header">Inventário de Peças</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Peça</th>
                            <th>Part Number</th>
                            <th>Etapa</th>
                            <th>Status</th>
                            <th>Preço</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pecas.forEach(peca => { %>
                            <tr>
                                <td><strong><%= peca.nome %></strong></td>
                                <td><%= peca.part_number || '-' %></td>
                                <td><%= peca.Etapa ? peca.Etapa.nome : '-' %></td>
                                <td>
                                    <span class="badge bg-<%= peca.status === 'Instalada' ? 'success' : (peca.status === 'Comprada' ? 'primary' : 'warning text-dark') %>">
                                        <%= peca.status %>
                                    </span>
                                </td>
                                <td>R$ <%= peca.preco %></td>
                            </tr>
                        <% }) %>
                        <% if(pecas.length === 0) { %>
                            <tr><td colspan="5" class="text-center py-3">Nenhuma peça registrada ainda.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>